# ── Client environment ───────────────────────────────────────────────
# Copy to `.env` (or set in your host's dashboard). Vite only exposes
# variables prefixed with VITE_.

# Base URL of the API, including the /api suffix (no trailing slash).
# Local dev:  http://localhost:5000/api
# Production: https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
