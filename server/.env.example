# ── Server environment ───────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# Port the API listens on (Render/Railway inject their own PORT).
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://localhost:27017/feature-roadmap
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/feature-roadmap?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/feature-roadmap

# JWT signing secrets — generate strong random values for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_me_in_production

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Public URL of the deployed frontend (used for CORS + email links).
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app   (no trailing slash)
CLIENT_URL=http://localhost:5173

BCRYPT_ROUNDS=12
